# Flutter/Dart
.dart_tool/
.packages
build/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
*.iml

# Android (generated by `flutter create` in CI — not needed in the repo,
# but harmless to keep out if you generate it locally too)
android/.gradle/
android/local.properties
android/key.properties
android/**/*.jks
android/**/*.keystore

# iOS (not used, but ignore if it ever gets generated)
ios/Pods/
ios/.symlinks/

# IDE
.idea/
.vscode/
*.swp
